# Copy to .env and fill in (the installers do the copy). .env is gitignored: never commit it.

# Your music folder (mp3, m4a, flac, ogg, wav; subfolders are included). Read-only: nothing is ever written there.
# Windows: MUSIC_PATH=D:\Music    Linux: MUSIC_PATH=/home/you/Music
MUSIC_PATH=
# PIN for the host page (/host): reorder, skip, settings. Pick your own.
HOST_PIN=
# YouTube Data API v3 key for songs that aren't in your library (optional; without it only the library is searched).
YT_API_KEY=

# --- optional ---
# ffmpeg with the rubberband filter. Empty = the ffmpeg on PATH (install.ps1 sets this on Windows if needed).
# FFMPEG_PATH=
# Processing device: auto (CUDA GPU if available, else CPU), cuda or cpu.
# DEVICE=auto
# Whisper model for lyrics transcription. Empty = large-v3 on a GPU, medium on the CPU (faster, a bit less accurate).
# WHISPER_MODEL=
# PORT=8765            HTTP port for phones, host page and TV
# DISCOVERY_PORT=8766  UDP port the TV app uses to find the server
# DATA_DIR=data        database, stems, renders, lyrics, logs
# PC_MAC=              Wake-on-LAN target for the TV's "Wake PC" button (default: the adapter with the LAN IP)
